// Two Screens using every Heading level and Text option.
Screen "Orders" subtitle="Manage and track customer orders"
  Heading "Recent orders"
  "Nothing shipped yet."
    // Comments are ignored at any indent.
  Text "Updated hourly" size=sm muted
  Text "Say \"hi\" to C:\\orders" bold

Screen "Order details" id=details
  Heading "Order #1042" level=1
  Heading "Items" level=3
  Heading "Notes" level=4
  Text "Large print, <b>escaped</b> & safe" size=lg
