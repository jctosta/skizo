{
  "name": "skizo-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "build": "pnpm -F @jctosta/skizo build",
    "typecheck": "tsc -p packages/core && tsc -p packages/cli",
    "test": "pnpm -F @jctosta/skizo assets && vitest run --project fast",
    "test:slow": "pnpm -F @jctosta/skizo assets && vitest run --project slow",
    "test:all": "pnpm -F @jctosta/skizo assets && vitest run"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "playwright": "1.64.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
